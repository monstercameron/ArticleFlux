# Nightly verified backup. Paired with articleflux-backup.timer.
#
# It runs `articleflux backup`, which is VACUUM INTO plus an integrity check on
# the copy — not a file copy. That distinction is the whole reason this unit
# exists rather than a cron line with `cp`: the database runs in WAL mode, so at
# any moment an unknown amount of committed data is in the -wal file and not in
# the .db. Copying the three files copies them at three different instants, and a
# writer in between produces a backup that opens cleanly and is missing a
# transaction. It restores, it passes a smoke test, and it is wrong.
#
# Install alongside the timer:
#   sudo install -m 0644 deploy/articleflux-backup.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now articleflux-backup.timer

[Unit]
Description=ArticleFlux nightly backup
# The only reason anybody finds out this failed.
#
# A backup is the one job whose failure is completely invisible until the moment
# it is needed, and at that moment the news is two disasters rather than one.
# Before this line, a failed run wrote to journald on a box nobody logs into.
OnFailure=articleflux-alert@%n.service
# Not After=articleflux.service: the backup opens the database directly and does
# not need the server up. A backup that silently skips itself because the server
# happened to be down is a backup missing from exactly the week you needed it.

[Service]
Type=oneshot
User=articleflux
Group=articleflux

# -keep 14 is two weeks. Long enough that a problem noticed on a Monday can be
# rolled back past the weekend it started, short enough that fourteen VACUUMed
# copies of a feed database are not a storage decision anyone has to think about.
#
# The command also copies secrets.key, proxy.key and speech.key into -out, and
# that is not a convenience: secrets.key seals the Smart+ key and every mailbox
# password, and a database restored without it produces a server that refuses to
# start. -keep only prunes the timestamped `articleflux-*` databases, so the keys
# are never rotated out from under the copies that need them.
#
# It follows that /var/backups/articleflux holds key material and must stay
# chmod 700 to this user, exactly like /var/lib/articleflux. The install steps in
# deploy/README.md already do that.
# A wrapper rather than `articleflux backup` directly, and the difference is
# the second half of the job: getting a copy OFF this machine.
#
# Fourteen verified backups, the database they came from and secrets.key all
# lived on one DigitalOcean volume, so the single event this is insurance
# against — losing the volume — took all three at once. A backup on the same
# disk as its source defends against `rm`, not against loss.
#
# The wrapper still runs the same command with the same flags; it then tars the
# newest copy with its key material, encrypts it to an `age` recipient, and
# ships it wherever /etc/articleflux/backup.env names. Encryption is REQUIRED
# rather than optional there, because that archive is the whole instance —
# every stored credential and the Smart+ key included.
#
# With nothing configured it is exactly the old behaviour plus one log line
# saying so, which is the point: "I thought that was set up" is the belief this
# is here to interrupt.
ExecStart=/usr/local/bin/articleflux-backup

Environment=ARTICLEFLUX_DB=/var/lib/articleflux/articleflux.db
Environment=ARTICLEFLUX_BACKUPS=/var/backups/articleflux
Environment=ARTICLEFLUX_BIN=/opt/articleflux/bin/articleflux
Environment=ARTICLEFLUX_KEEP=14

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/articleflux /var/backups/articleflux
