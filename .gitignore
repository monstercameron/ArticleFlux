# Everything generated lives under bin/ — the binaries, the wasm bundle, and the
# assembled web root. One ignored directory instead of build output scattered
# through the tree, so "is this file source?" is answerable from its path alone.
/bin/

# Databases and their WAL sidecars. A committed .db is somebody's reading history.
*.db
*.db-wal
*.db-shm
/data/
/backups/

# Synthesised speech. Every file here is one of the reader's articles read aloud
# and cached on disk — the same privacy class as the database, in a directory
# nobody thinks of as data.
/speech-cache/
*.mp3

# Cached site icons, if a future build ever spills them to disk rather than to
# the database.
/favicon-cache/

# Proxied article images (§10.1a). Same privacy class as speech-cache: every
# file in here is an image from something the reader opened, keyed by URL hash,
# so the directory listing alone is a reading history. It is also unbounded and
# regenerable, which is the other half of why it is not source.
/asset-cache/

# Proxied whole pages (§10.1b). Same reasoning as asset-cache: every entry is a
# page the reader opened, and the cache is regenerable.
/page-cache/

# OPML exports. Not a secret, but a complete list of what someone reads is the
# most personal file in a feed reader after the database itself.
*.opml

# One exception, and it is deliberately spelled out in full rather than written
# as a testdata glob. The import parser needs a full-size export to test against,
# so that fixture is SYNTHESISED and checked in — every hazard of a real export,
# nobody's reading list. Naming the single file keeps the rule above in force for
# everything else: drop a real freshrss.real.opml next to it and it stays ignored.
#
# This is here because the rule above silently swallowed that fixture, and the
# test called t.Skip rather than failing — so CI was green while the only
# real-world parse in the suite never ran once.
!internal/opml/testdata/freshrss.opml

# The wasm baseline IS checked in — CI ratchets the bundle size against it. The
# bundle itself is not.
*.wasm
*.wasm.gz

# Node, which only the e2e suite uses.
/e2e/node_modules/
/e2e/.tmp/
/e2e/test-results/
/e2e/playwright-report/
/e2e/blob-report/
/e2e/shots/
/e2e/*.log
/e2e/.playwright-artifacts-*/
# One-off probe scripts. They are written against whatever bug is in front of
# you, they hard-code a port and a database, and they are worthless a day later.
/e2e/_*.mjs

# Local configuration and secrets.
#
# The negation must come AFTER the pattern that would otherwise catch it — git
# applies these in order, so `!.env.example` above `.env.*` would be silently
# undone by the line below it.
.env
.env.*
.envrc
!.env.example

# Keys and certificates, by extension rather than by name. Nobody ever commits a
# file called "secret"; they commit `server.key` at half past midnight.
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
id_rsa*
id_ecdsa*
id_ed25519*
*_rsa
*.gpg
*.asc
secrets.*
credentials.*
*-credentials.json
service-account*.json

# Anything a person marks as theirs alone.
*.local
*.local.*
/scratch/
/tmp/

# Go build and test output.
*.exe
*.exe~
*.test
*.out
coverage.txt

# Editor and OS noise.
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
